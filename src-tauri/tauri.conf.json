{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCGoQuota",
  "version": "2.0.5",
  "identifier": "com.hub68.v2",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OCGoQuota",
        "width": 360,
        "height": 640,
        "resizable": false,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": [
      "../public/icon.png"
    ],
    "android": {
      "minSdkVersion": 28
    }
  }
}
